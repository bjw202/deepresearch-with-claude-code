{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "64000",
    "ENABLE_TOOL_SEARCH": "1",
    "PATH": "/Users/byunjungwon/.local/bin:/Users/byunjungwon/go/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "AskUserQuestion",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "WebFetch",
      "WebSearch",
      "mcp__context7__get-library-docs",
      "mcp__context7__resolve-library-id",
      "mcp__sequential-thinking__*",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(cut:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(./scripts/search.sh:*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "respectGitignore": true
}
